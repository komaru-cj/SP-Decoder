--- a/BEC/zlecc_gen_common.m
+++ b/BEC/zlecc_gen_common.m
@@ -105,4 +105,4 @@ for www=1:size(hereallcomb,1)
     end
     heregroup = [heregroup; toadd];
 end
-zlecc_common_cfg.CR4_2_group = heregroup;
\ No newline at end of file
+zlecc_common_cfg.CR4_2_group = heregroup;
