diff --git a/TnBDecode.m b/TnBDecode.m
new file mode 100644
index 0000000..cc16d0a
--- /dev/null
+++ b/TnBDecode.m
@@ -0,0 +1,31 @@
+% Copyright (C) 2022 
+% Florida State University 
+% All Rights Reserved
+
+% FOR EDUCATION AND ADADEMIC RESEARCH ONLY 
+
+function [decoded_packets, CRC_ok] = TnBDemod(TraceName, SF, decoder_type)
+
+BW = 125000; % NOT USED
+
+addpath ./Thrive
+addpath ./BEC
+addpath ./loracode
+addpath ./peakfinder
+
+zvl_init;
+
+load(TraceName)
+syms = double(syms);
+mat = syms;
+total = 0;
+decoded_packets = {};
+CRC_ok = [];
+for i = 1:size(mat,1)
+    curr = mat(i,:);
+    [CRC, zvl_found_pkt, zvl_additional_corrected] = zvl_decode_pkt_bits(curr, SF, decoder_type);
+    total = total + CRC;
+    CRC_ok = [CRC_ok CRC];
+    decoded_packets{end+1} = zvl_found_pkt;
+end
+end
diff --git a/TnBDemod.m b/TnBDemod.m
new file mode 100644
index 0000000..7f87d04
--- /dev/null
+++ b/TnBDemod.m
@@ -0,0 +1,28 @@
+% Copyright (C) 2022 
+% Florida State University 
+% All Rights Reserved
+
+% FOR EDUCATION AND ADADEMIC RESEARCH ONLY 
+
+function [found_LoRa_pkt] = TnBDemod(SF, BW, found_LoRa_pkt_start_time, found_LoRa_pkt_CFO)
+
+addpath ./Thrive
+addpath ./BEC
+addpath ./loracode
+addpath ./peakfinder
+
+thisfile = fopen(TraceName); A = fread(thisfile, 'int16'); fclose(thisfile); 
+zvl_LoRa_time_sig = A(1:2:end) + 1i*A(2:2:end); 
+
+A = [];
+zvl_LoRa_time_sig = transpose(zvl_LoRa_time_sig); 
+
+OSF = 8;
+
+zvl_init;
+
+load('found_LoRa_pkt_CFO.mat')
+load('found_LoRa_pkt_start_time.mat')
+[rcvsig,rcvdownchirpsig] = zvl_cal_rcvsig(BW, SF, OSF, zvl_cfg, found_LoRa_pkt_start_time, found_LoRa_pkt_CFO, zvl_LoRa_time_sig);
+found_LoRa_pkt = zvl_decode_found_pkts(BW, SF, OSF, zvl_cfg, found_LoRa_pkt_start_time,found_LoRa_pkt_CFO, rcvsig, rcvdownchirpsig);
+end
diff --git a/TnBMain.m b/TnBMain.m
index cdc5175..32b7b15 100644
--- a/TnBMain.m
+++ b/TnBMain.m
@@ -4,24 +4,36 @@
 
 % FOR EDUCATION AND ADADEMIC RESEARCH ONLY 
 
-TraceName = '../AEexpdata/outdoor1-SF8-CR4'; 
-SF = 8;
+TraceName = getenv("INPUT_FILE")
+output_file = getenv("OUTPUT_FILE");
+sync_file = getenv("SYNC_FILE")
+
+SF = str2num(getenv("SF"));
+BW = str2num(getenv("BW"))
 
 addpath ./Thrive
 addpath ./BEC
 addpath ./loracode
 addpath ./peakfinder
 
-thisfile = fopen(TraceName); A = fread(thisfile, 'int16'); fclose(thisfile); 
-zvl_LoRa_time_sig = A(1:2:end) + 1i*A(2:2:end); A = []; zvl_LoRa_time_sig = transpose(zvl_LoRa_time_sig); 
+thisfile = fopen(TraceName); A = fread(thisfile, 'int16=>single'); fclose(thisfile); 
+zvl_LoRa_time_sig = A(1:2:end) + 1i*A(2:2:end); 
+
+A = [];
+zvl_LoRa_time_sig = transpose(zvl_LoRa_time_sig); 
 
 OSF = 8;
-BW = 125000;
 
 zvl_init;
 
-[found_LoRa_pkt_start_time, found_LoRa_pkt_CFO] = zvl_detect_pkt(BW, SF, OSF, zvl_cfg, zvl_LoRa_time_sig);
+if isempty(sync_file)
+    [found_LoRa_pkt_start_time, found_LoRa_pkt_CFO] = zvl_detect_pkt(BW, SF, OSF, zvl_cfg, zvl_LoRa_time_sig);
+else
+    disp("Loading sync from mat file")
+    load(sync_file)
+end
 [rcvsig,rcvdownchirpsig] = zvl_cal_rcvsig(BW, SF, OSF, zvl_cfg, found_LoRa_pkt_start_time, found_LoRa_pkt_CFO, zvl_LoRa_time_sig);
 found_LoRa_pkt = zvl_decode_found_pkts(BW, SF, OSF, zvl_cfg, found_LoRa_pkt_start_time,found_LoRa_pkt_CFO, rcvsig, rcvdownchirpsig);
 
+save(output_file, 'found_LoRa_pkt')
 TnB_ReportResults;    
diff --git a/TnBSync.m b/TnBSync.m
new file mode 100644
index 0000000..5ba553c
--- /dev/null
+++ b/TnBSync.m
@@ -0,0 +1,25 @@
+% Copyright (C) 2022 
+% Florida State University 
+% All Rights Reserved
+
+% FOR EDUCATION AND ADADEMIC RESEARCH ONLY 
+
+function [found_LoRa_pkt_start_time, found_LoRa_pkt_CFO] = TnBSync(TraceName, SF, BW)
+
+addpath ./Thrive
+addpath ./BEC
+addpath ./loracode
+addpath ./peakfinder
+
+thisfile = fopen(TraceName); A = fread(thisfile, 'int16=>single'); fclose(thisfile); 
+zvl_LoRa_time_sig = A(1:2:end) + 1i*A(2:2:end); 
+
+A = [];
+zvl_LoRa_time_sig = transpose(zvl_LoRa_time_sig); 
+
+OSF = 8;
+
+zvl_init;
+
+[found_LoRa_pkt_start_time, found_LoRa_pkt_CFO] = zvl_detect_pkt(BW, SF, OSF, zvl_cfg, zvl_LoRa_time_sig);
+end
